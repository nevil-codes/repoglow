# Ollama server (default: local)
OLLAMA_HOST=http://127.0.0.1:11434

# Any installed model with good JSON output. Try: gpt-oss:20b, qwen3, llama3.1:8b
OLLAMA_MODEL=gpt-oss:20b

# Context window in tokens. Repo digests need ~15-25K; lower it if you run out of memory.
OLLAMA_NUM_CTX=32768

# Optional — raises GitHub API rate limit from 60 to 5,000 req/hour.
# A fine-grained token with no extra permissions (public repo read) is enough.
GITHUB_TOKEN=
