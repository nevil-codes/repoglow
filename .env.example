# Ollama server (default: local)
OLLAMA_HOST=http://127.0.0.1:11434

# Any installed model with good JSON output. Try: gpt-oss:20b, qwen3, llama3.1:8b
OLLAMA_MODEL=gpt-oss:20b

# Context window in tokens. Repo digests need ~15-25K; lower it if you run out of memory.
OLLAMA_NUM_CTX=32768

# How long the model stays in memory after a request (default 30m). Lower it to free RAM sooner.
OLLAMA_KEEP_ALIVE=30m

# Optional — raises the GitHub API rate limit (60 -> 5,000 req/hour) and enables
# "Ship to GitHub" (open PRs, apply About & topics). Needs public_repo (classic)
# or Contents + Pull requests write (fine-grained). Quick setup: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
